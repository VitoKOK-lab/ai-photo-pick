# Jewelry DB 環境設定
# 複製此檔為 .env，.env 不進 repo

# ── 認證 ──────────────────────────────────────────────
# 設定後，所有頁面需帶 ?token=VALUE 或 Authorization: Bearer VALUE
# 留空 = 本機開發模式（無需驗證）
JEWELRY_AUTH_TOKEN=

# ── CORS ──────────────────────────────────────────────
# 逗號分隔，留空 = 允許全部（本機用）
# 對外時改成 Cloudflare Tunnel domain
# JEWELRY_ALLOWED_ORIGINS=https://jewelry.yourdomain.com
JEWELRY_ALLOWED_ORIGINS=

# ── 備份 ──────────────────────────────────────────────
# rclone remote 名稱（rclone config 裡設定的遠端名稱）
JEWELRY_RCLONE_REMOTE=gdrive
# Google Drive 上的根目錄名稱
JEWELRY_RCLONE_BASE=jewelry-db
# 本地快照保留天數
JEWELRY_BACKUP_KEEP_DAYS=7
