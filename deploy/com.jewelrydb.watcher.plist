<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jewelrydb.watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/vito/jewelry-db/venv/bin/python</string>
        <string>-m</string>
        <string>scripts.watch_folder</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/vito/jewelry-db</string>

    <key>StandardOutPath</key>
    <string>/Users/vito/jewelry-db/logs/watcher.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/vito/jewelry-db/logs/watcher.err</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
